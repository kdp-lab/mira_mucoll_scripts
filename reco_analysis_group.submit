sample = $(sample) # 1000_10, 2500_10, 3000_10, 3500_10, 4000_10, 4500_10
window = $(window) # loose / medium / tight
bib_option = $(bib_option) # bib / nobib

Universe = Vanilla
+SingularityImage = "/cvmfs/unpacked.cern.ch/gitlab-registry.cern.ch/muon-collider/mucoll-deploy/mucoll:2.9-alma9"
Requirements = ( HAS_SINGULARITY ) && ( HAS_CVMFS_unpacked_cern_ch )

should_transfer_files = YES
Output  = outputs/output.out.$(Cluster)-$(Process)
Log     = outputs/log.$(Cluster)
Error   = outputs/error.out.$(Cluster)-$(Process)

transfer_input_files = /ospool/uc-shared/project/futurecolliders/miralittmann/reco/efficiency/$(bib_option)/$(window)/$(sample)/$(sample)_reco$(Step).slcio, /scratch/miralittmann/analysis/mira_analysis_code/reco_analysis.py
transfer_output_files = $(sample)_reco$(Step).json
transfer_output_remaps = "$(sample)_reco$(Step).json = /scratch/miralittmann/analysis/mira_analysis_code/efficiency/$(bib_option)/$(window)/$(sample)/$(sample)_reco$(Step).json"
when_to_transfer_output = ON_EXIT

request_cpus = 1
request_disk = 4 GB
request_memory = 8 GB
+ProjectName="collab.futurecolliders"

Executable = /scratch/miralittmann/analysis/mira_analysis_code/reco_analysis.sh
Arguments = --inputFile $(sample) --chunks 500 --nEvents 500 --pId $(Step)
Queue 500 sample,window,bib_option from (
1000_10,loose,bib
1000_10,loose,nobib
1000_10,medium,bib
1000_10,medium,nobib
1000_10,tight,bib
1000_10,tight,nobib
2500_10,loose,bib
2500_10,loose,nobib
2500_10,medium,bib
2500_10,medium,nobib
2500_10,tight,bib
2500_10,tight,nobib
3000_10,loose,bib
3000_10,loose,nobib
3000_10,medium,bib
3000_10,medium,nobib
3000_10,tight,bib
3000_10,tight,nobib
3500_10,loose,bib
3500_10,loose,nobib
3500_10,medium,bib
3500_10,medium,nobib
3500_10,tight,bib
3500_10,tight,nobib
4000_10,loose,bib
4000_10,loose,nobib
4000_10,medium,bib
4000_10,medium,nobib
4000_10,tight,bib
4000_10,tight,nobib
4500_10,loose,bib
4500_10,loose,nobib
4500_10,medium,bib
4500_10,medium,nobib
4500_10,tight,bib
4500_10,tight,nobib
)