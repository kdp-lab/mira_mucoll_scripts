sample = $(sample)
bib_option = nobib
Universe = Vanilla
+SingularityImage = "/cvmfs/unpacked.cern.ch/gitlab-registry.cern.ch/muon-collider/mucoll-deploy/mucoll:2.9-alma9"
Requirements = ( HAS_SINGULARITY ) && ( HAS_CVMFS_unpacked_cern_ch )
should_transfer_files = YES
Output  = outputs/output.out.$(Cluster)-$(Process)
Log     = outputs/log.$(Cluster)
Error   = outputs/error.out.$(Cluster)-$(Process)
transfer_input_files = /ospool/uc-shared/project/futurecolliders/miralittmann/reco/mira_time/v2/$(bib_option)/$(sample)/$(sample)_reco$(Step).slcio, /scratch/miralittmann/analysis/mira_analysis_code/reco_analysis.py
transfer_output_files = $(sample)_reco$(Step).json
transfer_output_remaps = "$(sample)_reco$(Step).json = /scratch/miralittmann/analysis/mira_analysis_code/mira_time/v3/$(bib_option)/$(sample)/$(sample)_reco$(Step).json"
when_to_transfer_output = ON_EXIT
request_cpus = 1
request_disk = 4 GB
request_memory = 8 GB
+ProjectName="collab.futurecolliders"
Executable = /scratch/miralittmann/analysis/mira_analysis_code/reco_analysis.sh
Arguments = --inputFile $(sample) --chunks 2500 --nEvents 2500 --pId $(Step)
Queue 2500 sample from (   
    1000_10
    2500_10
    3000_10
    3500_10
    4000_10
    4500_10
)